<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Big Cinematic Edge-to-Edge Backdrop Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/ivBannerBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <View
            android:layout_width="match_parent"
            android:layout_height="140dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_banner_shadow" />

    </com.google.android.material.card.MaterialCardView>

    <!-- 2. Floating Info Box (Aligned to Bottom Left of the image, span width) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBannerInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#E6121212"
        app:cardCornerRadius="14dp"
        app:cardElevation="10dp"
        app:strokeColor="#33FFFFFF"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- 🚀 Professional Rectangular Poster Box (2:3 Aspect Ratio, MovieBox Style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvBannerSmallPoster"
                android:layout_width="55dp"
                android:layout_height="0dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                app:strokeColor="#22FFFFFF"
                app:strokeWidth="1dp"
                app:layout_constraintDimensionRatio="2:3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <ImageView
                    android:id="@+id/ivBannerSmallPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@null" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvBannerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:text="Movie Title"
                android:textColor="@color/white"
                android:textSize="15sp"
                app:layout_constraintEnd_toStartOf="@id/ivBannerDownload"
                app:layout_constraintStart_toEndOf="@id/cvBannerSmallPoster"
                app:layout_constraintTop_toTopOf="@id/cvBannerSmallPoster" />

            <TextView
                android:id="@+id/tvBannerMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="2024 | Action"
                android:textColor="#CCCCCC"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/tvBannerTitle"
                app:layout_constraintStart_toStartOf="@id/tvBannerTitle"
                app:layout_constraintTop_toBottomOf="@id/tvBannerTitle" />

            <ImageView
                android:id="@+id/ivBannerDownload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_green"
                android:contentDescription="@string/btn_download"
                android:padding="7dp"
                android:src="@android:drawable/stat_sys_download"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/white" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
