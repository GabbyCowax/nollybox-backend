<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Deep Charcoal to Black Gradient -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="#0A0A0A"
                android:endColor="#000000"
                android:startColor="#1A1A1A"
                android:type="linear" />
        </shape>
    </item>

    <!-- Subtle Gold Lighting from Bottom -->
    <item>
        <shape>
            <gradient
                android:angle="90"
                android:centerX="0.5"
                android:centerY="1.2"
                android:endColor="#00000000"
                android:startColor="#15FFD700"
                android:type="radial"
                android:gradientRadius="800dp" />
        </shape>
    </item>
</layer-list>